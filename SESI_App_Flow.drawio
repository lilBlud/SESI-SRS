        <mxCell id="int_col_process" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;INTERACTIVE SESI APP WORKFLOW (FRONTEND &amp;amp; BACKEND)&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A5C;strokeColor=#1B3A5C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="800" height="32" as="geometry" />
        </mxCell>

        <!-- Swimlane 1: Risk Initiator -->
