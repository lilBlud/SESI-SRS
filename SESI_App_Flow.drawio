          <mxGeometry x="40" y="392" width="1020" height="320" as="geometry" />
        </mxCell>
        <mxCell id="int_role_review" value="&lt;b&gt;&lt;u&gt;2. VERIFICATION &amp;amp; APPROVAL&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Senior Manager CRMU&lt;/b&gt;&lt;br&gt;(Verifier)&lt;br&gt;&lt;br&gt;&lt;b&gt;CSSO / Head&lt;/b&gt;&lt;br&gt;(Approver)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Platform: SESI Admin &amp;amp; Governance Tab&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="440" width="200" height="180" as="geometry" />
