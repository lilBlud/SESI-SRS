        <mxCell id="int_node_approve_decide" value="&lt;b&gt;CSSO Approves?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="800" y="590" width="120" height="70" as="geometry" />
