        </mxCell>

        <!-- (2)(a) AD Auth Valid? -> Reject Box [Label: No (Red)] -->
        <mxCell id="edge_ad_fail" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;No&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C00000;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="node_ad_check" target="node_reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reject Box loop back to (2) AD Login -->
        <mxCell id="edge_reject_to_ad" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C00000;strokeWidth=1.2;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="node_reject" target="node_ad_login">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="198" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- (2)(a) AD Auth Valid? -> Dashboard Hub [Label: Yes (Green)] -->
        <mxCell id="edge_ad_success" value="&lt;b&gt;&lt;font color=&quot;#1E8449&quot;&gt;Yes (AD Valid)&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;align=left;fontSize=10;" edge="1" parent="1" source="node_ad_check" target="node_dashboard_hub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dashboard Hub -> (3)(a) Select Quiz Module (Path A) -->
        <mxCell id="edge_hub_to_quiz" value="&lt;font color=&quot;#154360&quot;&gt;&lt;b&gt;Take Quiz&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0;exitY=0.5;entryX=0.5;entryY=0;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="node_dashboard_hub" target="node_select_module">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="455" y="356" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Dashboard Hub -> (3)(b) Open Dictionary (Path B) -->
        <mxCell id="edge_hub_to_dict" value="&lt;font color=&quot;#145A32&quot;&gt;&lt;b&gt;Open Dictionary&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="node_dashboard_hub" target="node_open_dict">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="875" y="356" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- =================== PATH A CONNECTORS =================== -->

        <!-- (3)(a) Select Module -> (4)(a) Answer Questions -->
        <mxCell id="edge_quiz_module_to_ans" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_select_module" target="node_answer_quiz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (4)(a) Answer Questions -> (5)(a) First Scored Attempt? -->
        <mxCell id="edge_quiz_ans_to_attempt" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_answer_quiz" target="node_first_attempt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (5)(a) First Scored Attempt? -> Practice Mode [Label: No] -->
        <mxCell id="edge_attempt_to_practice" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;No&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="node_first_attempt" target="node_practice_mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Practice Mode to FINISH (Dashed Bypass Line routed safely at x=245) -->
        <mxCell id="edge_practice_to_finish" value="&lt;font color=&quot;#555555&quot;&gt;Review Only&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#418AB3;strokeWidth=1.2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;" edge="1" parent="1" source="node_practice_mode" target="node_finish">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="245" y="595" />
              <mxPoint x="245" y="1041" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- (5)(a) First Scored Attempt? -> (6)(a) Submit Quiz [Label: Yes (Ranked)] -->
        <mxCell id="edge_attempt_to_submit" value="&lt;b&gt;&lt;font color=&quot;#1E8449&quot;&gt;Yes&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;align=left;fontSize=10;" edge="1" parent="1" source="node_first_attempt" target="node_submit_quiz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (6)(a) Submit Quiz -> (7) Automated Scoring Engine (Swimlane 2) -->
        <mxCell id="edge_submit_to_score" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_submit_quiz" target="node_scoring_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (7) Scoring Engine -> (8) Commit to Database -->
        <mxCell id="edge_score_to_commit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_scoring_engine" target="node_commit_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (8) Commit to Database -> (9) SCORE APPEARS ON DASHBOARD! -->
        <mxCell id="edge_commit_to_dashboard" value="&lt;b&gt;&lt;font color=&quot;#0B5345&quot;&gt;Instant Sync&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#196F3D;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;align=left;fontSize=10;" edge="1" parent="1" source="node_commit_db" target="node_dashboard_score">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (9) Dashboard Score -> FINISH -->
        <mxCell id="edge_dashboard_to_finish" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#418AB3;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_dashboard_score" target="node_finish">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="737" y="948" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- =================== PATH B CONNECTORS =================== -->

        <!-- (3)(b) Open Dictionary -> (4)(b) Search & View Term -->
        <mxCell id="edge_dict_to_view" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_open_dict" target="node_view_term">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (4)(b) View Term -> (5)(b) Action Choice -->
        <mxCell id="edge_view_to_choice" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_view_term" target="node_dict_action_choice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (5)(b) Choice -> (6)(b)(i) Bookmark Term -->
        <mxCell id="edge_choice_to_bm" value="&lt;font color=&quot;#154360&quot;&gt;&lt;b&gt;Bookmark&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0;exitY=0.5;entryX=0.5;entryY=0;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="node_dict_action_choice" target="node_bookmark_term">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="762" y="595" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- (5)(b) Choice -> (6)(b)(ii) Export to PDF -->
        <mxCell id="edge_choice_to_export" value="&lt;font color=&quot;#145A32&quot;&gt;&lt;b&gt;Export PDF&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="node_dict_action_choice" target="node_export_pdf">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="955" y="595" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- (6)(b)(i) Bookmark Term -> Bookmark Synced (Swimlane 2) -->
        <mxCell id="edge_bm_to_sync" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_bookmark_term" target="node_bm_stored">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- (6)(b)(ii) Export to PDF -> PDF Document Generation Service (Swimlane 2) -->
        <mxCell id="edge_export_to_pdf_svc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_export_pdf" target="node_pdf_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bookmark Synced -> FINISH -->
        <mxCell id="edge_bm_to_finish" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#418AB3;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_bm_stored" target="node_finish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PDF Output -> FINISH -->
        <mxCell id="edge_pdf_to_finish" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#418AB3;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="node_pdf_output" target="node_finish">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="955" y="1041" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
