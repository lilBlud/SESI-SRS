        <mxCell id="int_node_reject" value="&lt;b&gt;Reject with Notes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;Feedback loop to Initiator&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#78281F;fontSize=10;" vertex="1" parent="1">
