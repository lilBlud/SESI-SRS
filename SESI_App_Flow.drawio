        <mxCell id="int_title_text" value="&lt;font color=&quot;#FFFFFF&quot; style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;SESI App — Integrated Corporate Risk Management &amp;amp; Register Architecture&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
