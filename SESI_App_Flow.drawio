        <mxCell id="int_node_new_entry" value="&lt;b&gt;New Risk Entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;Define Context &amp;amp; Description&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A5C;fontSize=10;" vertex="1" parent="1">
