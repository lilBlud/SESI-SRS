        <mxCell id="ie5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="int_node_rev_entry" target="int_node_critical_check" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C62828;fontColor=#C62828;fontSize=9;" edge="1" source="int_node_critical_check" target="int_node_submit_approval" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie7" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=9;" edge="1" source="int_node_critical_check" target="int_node_direct_save" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Swimlane 2: Risk Verifier & Approver (CRMU Governance Queue) -->
